{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"apiKeyHelper": "bash -c 'echo $FIREWORKS_API_KEY'",
	"model": "accounts/fireworks/routers/kimi-k2p5-turbo",
	"env": {
		"ANTHROPIC_BASE_URL": "https://api.fireworks.ai/inference/v1",
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
		"CLAUDE_CODE_NEW_INIT": "1",
		"CLAUDE_CODE_NO_FLICKER": "1",
		"CLAUDE_CODE_EFFORT_LEVEL": "MAX"
	},
	"attribution": { "commit": "", "pr": "" },
	"enabledPlugins": {
		"parallel@parallel-agent-skills": true,
		"codex@openai-codex": true,
		"frontend-design@claude-plugins-official": true
	},
	"extraKnownMarketplaces": {
		"parallel-agent-skills": {
			"source": { "source": "github", "repo": "parallel-web/parallel-agent-skills" }
		},
		"openai-codex": { "source": { "source": "github", "repo": "openai/codex-plugin-cc" } }
	},
	"effortLevel": "high",
	"skipDangerousModePermissionPrompt": true
}
