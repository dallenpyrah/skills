{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"apiKeyHelper": "bash -c 'echo your-api-key-1'",
	"model": "gpt-5.4(high)",
	"env": {
		"ANTHROPIC_BASE_URL": "http://localhost:8317",
		"ANTHROPIC_MODEL": "gpt-5.4(high)",
		"ANTHROPIC_SMALL_FAST_MODEL": "gpt-5.4-mini",
		"ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-5.3-codex(high)",
		"ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-5.4(low)",
		"ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-5.4(xhigh)",
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
		"CLAUDE_CODE_NEW_INIT": "1",
		"CLAUDE_CODE_NO_FLICKER": "1",
		"CLAUDE_CODE_EFFORT_LEVEL": "MAX"
	},
	"attribution": { "commit": "", "pr": "" },
	"enabledPlugins": {
		"parallel@parallel-agent-skills": true,
		"codex@openai-codex": true,
		"frontend-design@claude-plugins-official": true
	},
	"extraKnownMarketplaces": {
		"parallel-agent-skills": {
			"source": { "source": "github", "repo": "parallel-web/parallel-agent-skills" }
		},
		"openai-codex": { "source": { "source": "github", "repo": "openai/codex-plugin-cc" } }
	},
	"effortLevel": "high",
	"skipDangerousModePermissionPrompt": true
}
