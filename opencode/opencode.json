{
  "$schema": "https://opencode.ai/config.json",
  "model": "fireworks/accounts/fireworks/routers/kimi-k2p5-turbo",
  "autoupdate": true,
  "share": "manual",
  "provider": {
    "fireworks": {
      "options": {
        "apiKey": "{env:FIREWORKS_API_KEY}"
      }
    }
  },
  "plugin": [
    "opencode-openai-codex-auth"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "instructions": [
    "./AGENTS.md"
  ],
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  }
}
