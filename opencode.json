{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@0xsero/open-queue"
  ],
  "autoupdate": true,
  "snapshot": true,
  "share": "auto",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      ".next/**",
      ".turbo/**",
      "*.log",
      ".DS_Store"
    ]
  },
  "permission": "allow",
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "ast-grep": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/ast-grep/ast-grep-mcp", "ast-grep-server"],
      "enabled": true
    }
  }
}
