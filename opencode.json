{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@0xsero/open-queue"
  ],
  "autoupdate": true,
  "snapshot": true,
  "share": "auto",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      ".next/**",
      ".turbo/**",
      "*.log",
      ".DS_Store"
    ]
  },
  "permission": "allow"
}
